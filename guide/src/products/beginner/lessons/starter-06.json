      "id": "scene-02",
      "type": "explain",
      "section": "definition",
      "content": {
        "heading": "Kata kerja = 動詞",
        "paragraphs": [
          "Kata kerja disebut 動詞 (doushi).",
          "Ini sepuluh kata kerja yang akan sering kamu temui."
        ],
        "terms": [
          {
            "term": "動詞",
            "reading": "doushi",
            "meaning": "kata kerja"
          }
        ]
      }
    },
    {
      "id": "scene-03",
      "type": "vocab",
      "section": "examples",
      "content": {
        "heading": "Sepuluh kata kerja",
        "items": [
          {
            "ja": "食べる",
            "reading": "taberu",
            "id_text": "makan"
          },
          {
            "ja": "飲む",
            "reading": "nomu",
            "id_text": "minum"
          },
          {
            "ja": "行く",
            "reading": "iku",
            "id_text": "pergi"
          },
          {
            "ja": "来る",
            "reading": "kuru",
            "id_text": "datang"
          },
          {
            "ja": "見る",
            "reading": "miru",
            "id_text": "melihat"
          },
          {
            "ja": "聞く",
            "reading": "kiku",
            "id_text": "mendengar"
          },
          {
            "ja": "話す",
            "reading": "hanasu",
