    {
      "id": "scene-14",
      "type": "mistakes",
      "section": "mistakes",
      "content": {
        "heading": "Kesalahan yang sering dilakukan pemula",
        "items": [
          {
            "wrong": "Membaca は sebagai \"ha\" saat menjadi partikel",
            "right": "Bacalah \"wa\"",
            "why": "Hanya sebagai partikel dibaca \"wa\". Di dalam kata biasa tetap \"ha\"."
          },
          {
            "wrong": "Memakai は untuk menjawab \"Siapa yang...?\"",
            "right": "Pakai が",
            "why": "Jawaban atas pertanyaan \"siapa/apa\" adalah informasi baru, sehingga memakai が."
          },
          {
            "wrong": "わたしは ほん よみます (partikel hilang)",
            "right": "わたしは ほんを よみます",
            "why": "Tanpa を, hubungan antara \"buku\" dan \"membaca\" tidak ditandai."
          }
        ]
      }
    },
