        "heading": "Kesalahan yang sering dilakukan pemula",
        "items": [
          {
            "wrong": "Menukar シ dan ツ",
            "right": "シ = shi, ツ = tsu",
            "why": "Bedakan arah goresan kecilnya."
          },
          {
            "wrong": "Menukar ソ dan ン",
            "right": "ソ = so, ン = n",
            "why": "ン ada di bab berikutnya; kenali bedanya sejak sekarang."
          },
          {
            "wrong": "Menukar ス dan ヌ",
            "right": "ス = su, ヌ = nu",
            "why": "ヌ punya goresan tambahan di kanan bawah."
          }
        ]
      }
