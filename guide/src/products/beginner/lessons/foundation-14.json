        "items": [
          {
            "wrong": "わたしは ごはんを うちで たべます (kurang lazim)",
            "right": "わたしは うちで ごはんを たべます",
            "why": "Kalimat pertama masih dipahami, tetapi urutan waktu, topik, tempat, objek lebih natural."
          },
          {
            "wrong": "Menaruh kata kerja di tengah",
            "right": "Kata kerja selalu di akhir",
            "why": "Jika ada keterangan yang belum disebut, taruh sebelum kata kerja."
          },
          {
            "wrong": "Lupa partikel pada keterangan",
            "right": "Pasang partikel pada tiap keterangan",
            "why": "Partikel menandai peran tiap keterangan."
          }
        ]
      }
