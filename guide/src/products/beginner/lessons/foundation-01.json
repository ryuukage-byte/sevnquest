{
  "id": "foundation-01",
  "level": "BEGINNER",
  "category": "concept",
  "title": "Apa Itu Bahasa Jepang?",
  "summary": "Kenalan dulu dengan bahasa Jepang. Ternyata tidak seseram yang kamu kira.",
  "minutes": 6,
  "scenes": [
    {
      "id": "scene-01",
      "type": "introduction",
      "section": "introduction",
      "duration": 4000,
      "content": {
        "title": "日本語",
        "subtitle": "Kenalan dulu dengan bahasa Jepang"
      }
    },
    {
      "id": "scene-02",
      "type": "explain",
      "section": "definition",
      "content": {
        "heading": "Namanya \"nihongo\"",
        "paragraphs": [
          "Bahasa Jepang dalam bahasa Jepang disebut 日本語.",
          "Dibaca: ni-hon-go. Artinya: bahasa Jepang."
        ]
      }
    },
    {
      "id": "scene-03",
      "type": "explain",
      "section": "concept",
      "content": {
        "heading": "Tenang, kamu pasti bisa",
        "paragraphs": [
          "Kamu tidak perlu hafal semuanya hari ini.",
          "Kita belajar pelan-pelan. Satu langkah kecil setiap kali."
        ]
      }
    },
    {
      "id": "scene-04",
      "type": "explain",
      "section": "logic",
      "content": {
        "heading": "Ada kabar baik",
        "paragraphs": [
          "Kata kerja tidak berubah untuk \"saya\", \"kamu\", atau \"dia\".",
          "Tidak ada kata jamak yang ribet.",
          "Bunyinya mudah, mirip bunyi bahasa Indonesia."
        ]
      }
    },
    {
      "id": "scene-05",
      "type": "explain",
      "section": "concept",
      "content": {
        "heading": "Yang beda cuma satu",
        "paragraphs": [
          "Urutan kalimatnya terbalik.",
          "Kata kerja (misalnya \"makan\") ditaruh di paling akhir."
        ],
        "analogy": "Kita bilang: \"Saya makan apel.\" Orang Jepang bilang: \"Saya apel makan.\""
      }
    },
    {
      "id": "scene-06",
      "type": "example",
      "section": "examples",
      "content": {
        "parts": [
          {
            "ja": "わたし",
            "reading": "わたし",
            "romaji": "watashi",
            "id_text": "saya",
            "role": "subject"
          },
          {
            "ja": "は",
            "reading": "は",
            "romaji": "wa",
            "id_text": "penanda topik",
            "role": "particle"
          },
          {
            "ja": "りんご",
            "reading": "りんご",
            "romaji": "ringo",
            "id_text": "apel",
            "role": "object"
          },
          {
            "ja": "を",
            "reading": "を",
            "romaji": "o",
            "id_text": "penanda objek",
            "role": "particle"
          },
          {
            "ja": "たべます",
            "reading": "たべます",
            "romaji": "tabemasu",
            "id_text": "makan",
            "role": "verb"
          }
        ],
        "translation": "Saya makan apel.",
        "heading": "Coba lihat contohnya",
        "note": "Ketuk tiap kotak untuk melihat artinya. Perhatikan: \"makan\" ada di paling akhir."
      }
    },
    {
      "id": "scene-07",
      "type": "explain",
      "section": "concept",
      "content": {
        "heading": "Ada tiga jenis tulisan",
        "paragraphs": [
          "Orang Jepang memakai tiga jenis tulisan sekaligus.",
          "Namanya hiragana, katakana, dan kanji.",
          "Tenang, kita belajar satu per satu."
        ]
      }
    },
    {
      "id": "scene-08",
      "type": "quiz",
      "section": "exercises",
      "content": {
        "question": "\"Makan\" dalam kalimat Jepang ditaruh di mana?",
        "options": [
          "Di paling depan",
          "Di tengah",
          "Di paling akhir"
        ],
        "answer": 2,
        "why": [
          "Bukan di depan, tetapi di akhir.",
          "Bukan di tengah, tetapi di akhir.",
          null
        ]
      }
    },
    {
      "id": "scene-09",
      "type": "quiz",
      "section": "exercises",
      "content": {
        "question": "\"Saya makan apel\" kalau dibalik seperti orang Jepang jadi...",
        "options": [
          "Saya apel makan",
          "Makan saya apel",
          "Apel makan saya"
        ],
        "answer": 0,
        "why": [
          null,
          "Kata kerja harus di akhir.",
          "Kata kerja harus di akhir."
        ]
      }
    },
    {
      "id": "scene-10",
      "type": "summary",
      "section": "summary",
      "content": {
        "heading": "Rangkuman",
        "points": [
          "Bahasa Jepang disebut 日本語 (nihongo).",
          "Kata kerja ada di paling akhir kalimat.",
          "Ada tiga jenis tulisan. Kita belajar satu per satu."
        ]
      }
    }
  ]
