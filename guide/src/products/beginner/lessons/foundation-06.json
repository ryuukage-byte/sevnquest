        "items": [
          {
            "wrong": "Selalu menyebut \"saya\" di setiap kalimat",
            "right": "Hilangkan subjek bila sudah jelas",
            "why": "Mengulang わたしは terus-menerus terdengar kaku dan tidak natural."
          },
          {
            "wrong": "Mencari padanan kata untuk setiap kata Indonesia",
            "right": "Cari padanan makna kalimat, bukan kata per kata",
            "why": "Jepang menghilangkan bagian yang bagi kita wajib disebut."
          },
          {
            "wrong": "Lupa partikel か saat bertanya",
            "right": "Tambahkan か di akhir kalimat",
            "why": "Tanpa か (dan nada naik), kalimat terdengar seperti pernyataan."
          }
        ]
      }
