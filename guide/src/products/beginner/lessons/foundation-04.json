      "content": {
        "heading": "Kesalahan yang sering dilakukan pemula",
        "items": [
          {
            "wrong": "Menukar シ dan ツ",
            "right": "シ = shi, ツ = tsu",
            "why": "Bedanya ada pada arah goresan pendek. Latih membaca keduanya berdampingan."
          },
          {
            "wrong": "Menukar ソ dan ン",
            "right": "ソ = so, ン = n",
            "why": "Sama: arah goresannya berbeda."
          },
          {
            "wrong": "Mengabaikan ー pada コーヒー",
            "right": "Baca panjang: koohii",
            "why": "Tanpa ー, kata bisa berubah arti atau terdengar janggal."
          }
        ]
      }
    },
