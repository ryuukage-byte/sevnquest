      "section": "concept",
      "content": {
        "heading": "Bukan sekadar terjemahan",
        "paragraphs": [
          "Bahasa Jepang bukan bahasa Indonesia yang diganti kata-katanya.",
          "Tulisannya, susunan kalimatnya, dan cara menyampaikannya berbeda."
        ]
      }
    },
