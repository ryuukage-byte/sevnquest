        "items": [
          {
            "wrong": "わたしは たべます りんごを。",
            "right": "わたしは りんごを たべます。",
            "why": "Kata kerja harus di akhir, bukan di tengah."
          },
          {
            "wrong": "りんご あかい (penjelas sesudah kata benda)",
            "right": "あかい りんご",
            "why": "Penjelas diletakkan sebelum kata yang dijelaskan."
          },
          {
            "wrong": "わたしを りんごは たべます。 (partikel tertukar)",
            "right": "わたしは りんごを たべます。",
            "why": "は menandai topik (pelaku) dan を menandai objek. Kalau tertukar, artinya menjadi aneh."
          }
        ]
      }
