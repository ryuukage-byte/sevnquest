{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "moduleResolution": "bundler", "isolatedModules": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "jsx": "react-jsx",
    "noEmit": true, "strict": true, "types": ["node"]
  },
  "include": ["src", "vite.config.ts"]
}
