# ============================================================================
# SevnQuest / Nihongo Quest - contoh konfigurasi lingkungan
# Salin ke .env (sudah di-ignore git). JANGAN commit nilai rahasia.
# ============================================================================

# --- Klien (di-bundle ke browser; semua yang berawalan VITE_ BERSIFAT PUBLIK) ---
# Hanya boleh berisi URL proyek dan ANON key Supabase. Jangan pernah menaruh service_role di sini.
# Bila kosong, kode memakai nilai bawaan di src/lib/supabase.ts.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Skrip server-side saja (scripts/ai_consultant.mjs dsb.) - tidak masuk bundle ---
ENX_API_KEY=""
ENX_BASE_URL=""
DEFAULT_AI_MODEL=""

# --- Pembuat Deck AI (opsional; fungsi server api/deck-topic.ts) ---
# Penyedia apa pun yang kompatibel dengan OpenAI chat/completions (tier gratis Gemini, Groq, OpenRouter, dsb).
# Kosong = pembuat deck memakai pencocokan lokal saja (tetap berfungsi penuh). JANGAN berawalan VITE_.
# Contoh Gemini: DECK_AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
DECK_AI_BASE_URL=""
DECK_AI_API_KEY=""
DECK_AI_MODEL=""

# --- Opsional ---
# Port server J-LIE engine (server/engineServer.ts)
PORT=4000

# true => tampilkan tombol Google (aktifkan provider Google di Supabase dulu; juga isi VITE_GOOGLE_CLIENT_ID)
VITE_GOOGLE_AUTH=""
VITE_GOOGLE_CLIENT_ID=""
