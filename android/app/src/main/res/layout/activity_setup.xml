<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setup_message"
            style="@style/Body"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:text="@string/setup_message" />

        <LinearLayout
            android:id="@+id/setup_details"
            style="@style/Card">

            <TextView
                style="@style/Secondary"
                android:layout_marginTop="0dp"
                android:text="@string/setup_host_label" />

            <TextView
                android:id="@+id/setup_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Secondary"
                android:layout_marginTop="14dp"
                android:text="@string/setup_url_label" />

            <TextView
                android:id="@+id/setup_url"
                style="@style/Body"
                android:layout_marginTop="2dp"
                android:textIsSelectable="true" />

            <TextView
                style="@style/Secondary"
                android:layout_marginTop="14dp"
                android:text="@string/setup_key_label" />

            <TextView
                android:id="@+id/setup_key"
                style="@style/Body"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/setup_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="@color/status_warn"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setup_cancel"
                style="@style/ActionButton"
                android:text="@string/btn_cancel" />

            <Button
                android:id="@+id/setup_connect"
                style="@android:style/Widget.Material.Button.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:filterTouchesWhenObscured="true"
                android:minHeight="48dp"
                android:text="@string/btn_connect"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
